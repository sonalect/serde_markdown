# Write build outputs in a platform-specific directory;
# avoid outputs being wiped and rewritten when switching between platforms.
common --experimental_platform_in_output_dir
common --enable_platform_specific_config
# Use a symlink prefix to avoid clobbering the workspace root.
build --symlink_prefix=.bazel/
# rules_rust tests need runfiles; Windows defaults this off.
common --enable_runfiles

# Windows: the C and C++ code of external modules (protobuf, abseil) compiled
# for the build tools is not ours to fix; keep its compiler warnings out of the log.
build:windows --per_file_copt=external/.*@/w
build:windows --host_per_file_copt=external/.*@/w
# macOS: the Bazel C++ toolchain passes -target <SDK version> to the linker
# while rustc adds -mmacosx-version-min, and clang warns about the overriding
# on every crate. The linker's messages are not ours to act on.
build:macos --@rules_rust//rust/settings:extra_rustc_flag=-Alinker-messages
build:macos --@rules_rust//rust/settings:extra_exec_rustc_flag=-Alinker-messages
