load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# The public `(markdown.body)` option, at its import path under `proto/`. It
# lives inside the crate so a consumer gets it through the Cargo dependency
# (README, "Proto option from Bazel"); there is no Bazel module to depend on.
filegroup(
    name = "proto",
    srcs = ["proto/markdown/options.proto"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "serde_markdown",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(
        ["testdata/markdown/**/*.md"],
        allow_empty = True,
    ),
    crate_features = [
        "buffa",
        "derive",
        "json",
        "tokio",
        "toml",
        "yaml",
    ],
    crate_name = "serde_markdown",
    proc_macro_deps = [
        "//rust/markdown_derive:serde_markdown_derive",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@serde_markdown_cargo//:buffa",
        "@serde_markdown_cargo//:buffa-descriptor",
        "@serde_markdown_cargo//:buffa-types",
        "@serde_markdown_cargo//:pulldown-cmark",
        "@serde_markdown_cargo//:serde",
        "@serde_markdown_cargo//:serde_json",
        "@serde_markdown_cargo//:tokio",
        "@serde_markdown_cargo//:toml",
        "@serde_markdown_cargo//:yaml_serde",
    ],
)

rust_test(
    name = "serde_markdown_test",
    compile_data = glob(
        ["testdata/markdown/**/*.md"],
        allow_empty = True,
    ),
    crate = ":serde_markdown",
    crate_features = [
        "buffa",
        "derive",
        "json",
        "tokio",
        "toml",
        "yaml",
    ],
    proc_macro_deps = [
        "//rust/markdown_derive:serde_markdown_derive",
    ],
    visibility = ["//rust:__pkg__"],
    deps = [
        "//rust/proto",
        "@serde_markdown_cargo//:buffa",
        "@serde_markdown_cargo//:buffa-descriptor",
        "@serde_markdown_cargo//:buffa-types",
        "@serde_markdown_cargo//:serde_json",
    ],
)

rust_doc_test(
    name = "serde_markdown_doc_test",
    crate = ":serde_markdown",
    crate_features = [
        "buffa",
        "derive",
        "json",
        "tokio",
        "toml",
        "yaml",
    ],
    deps = [
        "@serde_markdown_cargo//:serde",
        "@serde_markdown_cargo//:tokio",
    ],
)

