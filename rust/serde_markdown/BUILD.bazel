load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "serde_markdown",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(
        ["testdata/markdown/**/*.md"],
        allow_empty = True,
    ),
    crate_features = [
        "derive",
        "json",
        "toml",
        "yaml",
    ],
    crate_name = "serde_markdown",
    proc_macro_deps = [
        "//rust/serde_markdown_derive",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@cargo//:pulldown-cmark",
        "@cargo//:serde",
        "@cargo//:serde_json",
        "@cargo//:toml",
        "@cargo//:yaml_serde",
    ],
)

rust_test(
    name = "serde_markdown_test",
    compile_data = glob(
        ["testdata/markdown/**/*.md"],
        allow_empty = True,
    ),
    crate = ":serde_markdown",
    crate_features = [
        "derive",
        "json",
        "toml",
        "yaml",
    ],
    proc_macro_deps = [
        "//rust/serde_markdown_derive",
    ],
    visibility = ["//rust:__pkg__"],
    deps = [
        "//rust/generated",
        "@cargo//:buffa",
        "@cargo//:buffa-types",
        "@cargo//:serde_json",
    ],
)

